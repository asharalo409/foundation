export type SurahRow = { n: number; name: string; mean: string; ayahs: number; madani: boolean; page: number }

export const SURAHS: SurahRow[] = RAW.map(([ayahs, t, page], i) => ({
  n: i + 1,
  name: SURAH_BN[i]?.[0] || '',
  mean: SURAH_BN[i]?.[1] || '',
  ayahs,
  madani: t === 1,
  page,
}))

// এই পৃষ্ঠায় যে সূরা চলছে
export function surahAt(page: number): SurahRow {
  let r = SURAHS[0]
  for (const s of SURAHS) if (s.page <= page) r = s
  return r
}
